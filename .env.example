NODE_ENV=development
HOST=127.0.0.1
PORT=4000
HOCUSPOCUS_PORT=4001
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
DISCONNECT_GRACE_MS=5000
CORS_ORIGIN=http://localhost:5173
# Optional comma-separated override. Defaults to CORS_ORIGIN when omitted.
ALLOWED_WS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
PISTON_EXECUTE_URL=http://127.0.0.1:2000/api/v2/execute
# Set this to the complete Authorization header value only when your Piston deployment requires it.
# PISTON_AUTHORIZATION=Bearer replace-me
PISTON_PYTHON_VERSION=*
PISTON_JAVA_VERSION=*
PISTON_C_VERSION=*
PISTON_CPP_VERSION=*
PISTON_JAVASCRIPT_VERSION=*
EXECUTION_MAX_SOURCE_BYTES=65536
EXECUTION_MAX_STDIN_BYTES=16384
EXECUTION_MAX_OUTPUT_BYTES=65536
EXECUTION_TIMEOUT_MS=10000
EXECUTION_RATE_WINDOW_MS=60000
EXECUTION_USER_RATE_LIMIT=10
EXECUTION_ROOM_RATE_LIMIT=30
TIMER_MIN_SECONDS=60
TIMER_MAX_SECONDS=14400
